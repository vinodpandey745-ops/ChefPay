# Copy to .env and edit:  cp .env.example .env
# ----------------------------------------------------------------------------
# Choose ONE database mode
# ----------------------------------------------------------------------------

# A) PostgreSQL (default, recommended)
COMPOSE_PROFILES=postgres
SPRING_PROFILES_ACTIVE=postgres
CHEFPAY_DB_URL=jdbc:postgresql://postgres:5432/chefpay

# B) MySQL  -> comment A and uncomment these
# COMPOSE_PROFILES=mysql
# SPRING_PROFILES_ACTIVE=mysql
# CHEFPAY_DB_URL=jdbc:mysql://mysql:3306/chefpay
# MYSQL_ROOT_PASSWORD=change-me-too

# C) SQLite, single-terminal demo only  -> comment A and use:
# COMPOSE_PROFILES=
# SPRING_PROFILES_ACTIVE=dev

DB_USER=chefpay
DB_PASSWORD=change-me

# ----------------------------------------------------------------------------
# Security - REQUIRED. Generate with:  openssl rand -base64 48
# ----------------------------------------------------------------------------
CHEFPAY_SECURITY_JWT_SECRET=
# Guards the /platform owner endpoint; blank = endpoint refuses everything
CHEFPAY_PLATFORM_OWNER_KEY=

# ----------------------------------------------------------------------------
# Optional integrations (blank = disabled)
# ----------------------------------------------------------------------------
CHEFPAY_WHATSAPP_WEBHOOK_SECRET=
CHEFPAY_RAZORPAY_KEY_ID=
CHEFPAY_RAZORPAY_KEY_SECRET=
CHEFPAY_RAZORPAY_WEBHOOK_SECRET=

# ----------------------------------------------------------------------------
# Ports / runtime / build
# ----------------------------------------------------------------------------
# Public port of the web entry point (chefpay-web)
DOMAIN=pos.yourdomain.com
DOCKERHUB_USER=yourdockerhubname
CHEFPAY_VERSION=1.0.1
TZ=Asia/Kolkata
JAVA_OPTS=-XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError
SKIP_TESTS=true
INSTALL_OCR=true
